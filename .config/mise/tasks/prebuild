#!/usr/bin/env bash
#MISE description="Download Go modules, pre-compile dependencies, and build the Docker deps stage"
#MISE sources=["go.mod", "go.sum"]
set -euo pipefail
# shellcheck source=/dev/null
source "$MISE_PROJECT_ROOT/.config/mise/lib.sh"
cd "$ROOT"

# Compute a stable hash of the dependency inputs (includes go version).
# Do this before redirecting stdout so the sub-task output is captured.
sum=$(xt_prebuild_hash)

# Redirect all build tool output to stderr so stdout carries only the final hash.
exec 3>&1 1>&2

# Download all module dependency sources into the module cache.
go mod download

# Pre-compile only external dependency packages for every release platform to
# warm the Go build cache.  Excludes this module's own packages (.Module.Main)
# so the cache isn't polluted with a potentially stale project build.
for os in linux darwin windows; do
    for arch in amd64 arm64; do
        echo "  pre-compiling deps for $os/$arch"
        GOOS=$os GOARCH=$arch xt_precache_deps
    done
done

# Compile all test binaries for the host platform to warm the Go build cache.
# go build -cover produces different cache entries from go test -cover because
# go test only instruments the package under test, not its imported deps.  So
# xt_precache_deps -race -cover was a cache miss for nearly everything go test
# looked up.  Running go test with -count=0 (compile only, no execution) uses
# the exact same flags and build graph as the real gotest run, so every package
# compilation is a cache hit and gotest only needs to execute the tests (~6s)
# instead of compiling + running them (~49s).
echo "  compiling test binaries for host (race + cover)"
go test -race -cover -run='^$' -count=0 ./...

# Build and tag the Dockerfile deps stage (copies go.mod/go.sum and runs
# go mod download inside the container image layer cache).
docker build --target deps -t "infogulch/xtemplate:deps" .

# Emit the hash to stdout (fd 3).
printf '%s\n' "$sum" >&3
